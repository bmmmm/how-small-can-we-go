{
  "c": {
    "image": "gcc:14",
    "syntax": {
      "extensions": [".c", ".h"],
      "lineComments": ["//"],
      "blockComments": [["/*", "*/"]],
      "strings": [
        { "open": "\"", "close": "\"", "escape": "\\" },
        { "open": "'", "close": "'", "escape": "\\" }
      ],
      "noDiscountFile": ["\\?\\?/", "#\\s*define.*#", "__func__", "__FUNCTION__", "__PRETTY_FUNCTION__"]
    }
  },
  "go": {
    "image": "golang:1.26-alpine",
    "syntax": {
      "extensions": [".go"],
      "lineComments": ["//"],
      "blockComments": [["/*", "*/"]],
      "strings": [
        { "open": "\"", "close": "\"", "escape": "\\" },
        { "open": "`", "close": "`", "multiline": true },
        { "open": "'", "close": "'", "escape": "\\" }
      ],
      "blockCommentIsNewline": true,
      "noDiscountFile": ["\\breflect\\b", "\\bruntime\\b", "%[+#]v"],
      "keepComments": ["^//go:", "^//line ", "^//export "]
    }
  },
  "python": {
    "image": "python:3.13-alpine",
    "syntax": {
      "extensions": [".py"],
      "lineComments": ["#"],
      "strings": [
        { "open": "\"\"\"", "close": "\"\"\"", "escape": "\\", "multiline": true },
        { "open": "'''", "close": "'''", "escape": "\\", "multiline": true },
        { "open": "\"", "close": "\"", "escape": "\\" },
        { "open": "'", "close": "'", "escape": "\\" }
      ],
      "wsSensitive": true,
      "noDiscountFile": [
        "__",
        "\\b(globals|locals|vars|dir|eval|exec|getattr|setattr|delattr|compile|breakpoint|help)\\s*\\(",
        "\\b(inspect|ctypes|pickle|marshal)\\b",
        "[fF][rRbB]?[\"']{3}",
        "[rRbB][fF][\"']{3}"
      ],
      "noDiscountFileExempt": ["if __name__ == \"__main__\":", "if __name__ == '__main__':", "__init__"],
      "noDiscountLine": ["[fF][rRbB]?[\"']", "[rRbB][fF][\"']"],
      "keepComments": ["^#!", "coding[:=]"]
    }
  },
  "rust": {
    "image": "rust:1.83-alpine",
    "syntax": {
      "extensions": [".rs"],
      "lineComments": ["//"],
      "blockComments": [["/*", "*/"]],
      "strings": [
        { "open": "\"", "close": "\"", "escape": "\\", "multiline": true }
      ],
      "noDiscountFile": ["'\"", "\\br#*\"", "\\bbr", "stringify!", "macro_rules!", "type_name", "derive\\s*\\(\\s*Debug"]
    }
  },
  "sh": { "image": "alpine:3.21" }
}
